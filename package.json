{
  "name": "deepseek-desktop",
  "version": "1.6.13",
  "description": "DeepSeek 桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/security.test.js && node test/runner.test.js && node test/preload-guard.test.js && node test/shell-security.test.js && node test/theme.test.js",
    "build": "npm test && electron-builder --win --x64"
  },
  "author": "guihuo125",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.guihuo125.deepseek",
    "productName": "DeepSeek",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "probe.js",
      "security.js",
      "runner.js",
      "runner-worker.js",
      "dialog.html",
      "dialog-preload.js",
      "shell.html",
      "shell-preload.js",
      "security.html",
      "security-preload.js",
      "themes/**/*",
      "assets/**/*",
      "!assets/*.png",
      "!assets/*.ico.bak"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "guihuo125",
        "repo": "deepseek-desktop",
        "releaseType": "release"
      }
    ]
  }
}
